{
  "name": "fussenn",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "productName": "Fussenn",
  "author": "Fussenn contributors",
  "description": "本文に付箋を添えて、AIと読み書きするローカルアプリ。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "icons:generate": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "desktop:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Install-Shortcuts.ps1",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop": "node scripts/desktop-run.mjs",
    "desktop:pack": "node scripts/desktop-package.mjs --dir",
    "desktop:dist": "node scripts/desktop-package.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:desktop:packaged": "node scripts/desktop-verify.mjs",
    "test:desktop:installer": "node scripts/desktop-installer-verify.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:codex": "vitest run --config vitest.live.config.ts",
    "test:operations": "vitest run --config vitest.operations.config.ts",
    "check": "npm run icons:check && npm run lint && npm run typecheck && npm run test && npm run test:tooling && npm run build",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "secrets:check": "node scripts/secrets-check.mjs",
    "licenses:report": "node scripts/license-report.mjs",
    "licenses:check": "node scripts/license-report.mjs --check",
    "source:archive": "node scripts/source-archive.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "overrides": {
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "better-sqlite3": "^13.0.3",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next": "^16.3.8",
    "openai": "^7.13.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^28.1.0",
    "resedit": "1.7.2",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "undici": "7.29.1",
    "vitest": "^5.0.0"
  }
}
