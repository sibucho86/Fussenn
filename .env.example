# Copy to .env.local. Secrets are read only by the local server.
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=
CODEX_BIN=codex
# Default: ~/.fussenn (an existing ~/.sidenote-ai from before the rename is used in place)
FUSSENN_DATA_DIR=
# Enable to try the complete UX without an API key or external requests.
ENABLE_MOCK_PROVIDER=false
